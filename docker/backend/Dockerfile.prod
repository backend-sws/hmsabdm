FROM php:8.4-fpm-alpine

# Install system dependencies and build libraries
RUN apk add --no-cache \
    postgresql-dev \
    git \
    unzip \
    libzip-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    icu-dev \
    libxml2-dev \
    linux-headers \
    oniguruma-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo \
        pdo_pgsql \
        zip \
        bcmath \
        pcntl \
        intl \
        exif \
        gd \
        opcache

# Install Redis extension
RUN apk add --no-cache pcre-dev $PHPIZE_DEPS \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del $PHPIZE_DEPS

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

# Copy composer files and install production dependencies
COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader --no-scripts

# Copy full backend application code
COPY backend/ ./

# Clean any stale bootstrap cache files copied from development
RUN rm -f bootstrap/cache/*.php

# Run optimized autoloader
RUN composer dump-autoload --optimize --no-dev

# Setup entrypoint
COPY docker/backend/entrypoint.prod.sh /usr/local/bin/entrypoint.prod.sh
RUN chmod +x /usr/local/bin/entrypoint.prod.sh

EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/entrypoint.prod.sh"]
CMD ["php-fpm"]
